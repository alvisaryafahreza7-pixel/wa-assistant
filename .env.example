# Salin file ini jadi .env di hosting, lalu isi WA_TOKEN.
HOST=0.0.0.0
PORT=3000

# Isi dengan isi file .token lokal kamu (jangan commit / jangan share).
WA_TOKEN=

# 1 = balasan AI & perintah coba-coba cuma tampil di log, tidak dikirim ke WA.
DRY_RUN=0

# 1 = jalankan server API saja tanpa koneksi WhatsApp (untuk tes lokal).
NO_WA=0
